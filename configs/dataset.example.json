{
  "version": 1,
  "sample_rate": 16000,
  "min_duration_s": 0.3,
  "max_duration_s": 30.0,
  "splits": {
    "train": {
      "manifest": "${PVAI_CORPUS_ROOT:-corpus}/manifests/train.jsonl",
      "audio_root": "${PVAI_CORPUS_ROOT:-corpus}/audio",
      "out": "${PVAI_CORPUS_ROOT:-corpus}/validated/train.jsonl"
    },
    "validation": {
      "manifest": "${PVAI_CORPUS_ROOT:-corpus}/manifests/validation.jsonl",
      "audio_root": "${PVAI_CORPUS_ROOT:-corpus}/audio",
      "out": "${PVAI_CORPUS_ROOT:-corpus}/validated/validation.jsonl",
      "max_duration_s": 30.0
    },
    "test": {
      "manifest": "${PVAI_CORPUS_ROOT:-corpus}/manifests/test.jsonl",
      "audio_root": "${PVAI_CORPUS_ROOT:-corpus}/audio",
      "out": "${PVAI_CORPUS_ROOT:-corpus}/validated/test.jsonl"
    }
  }
}
