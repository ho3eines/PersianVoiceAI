# --- Local model runtime (llama.cpp backend) ---
PVAI_MODEL_PATH=models/Qwen3-4B-Q4_K_M.gguf
PVAI_LLAMA_SERVER_URL=http://127.0.0.1:8080
PVAI_N_CTX=4096
PVAI_N_THREADS=0          # 0 = auto (all logical cores)
PVAI_N_GPU_LAYERS=0       # 0 = CPU-only; >0 offloads layers to GPU (Metal/CUDA/Vulkan)

# --- Generation defaults ---
PVAI_TEMPERATURE=0.7
PVAI_MAX_TOKENS=512
PVAI_TIMEOUT=180          # request timeout to llama-server (seconds)

# --- Local API ---
PVAI_HOST=127.0.0.1
PVAI_PORT=8000
PVAI_LOG_LEVEL=INFO

# Optional: override the Persian system prompt
# PVAI_SYSTEM_PROMPT=تو یک دستیار فارسی‌زبان هستی.
# Optional offline PC voice client (local model files only)
PVAI_ASR_MODEL_PATH=models/whisper-small
PVAI_TTS_MODEL_PATH=models/piper/fa_IR.onnx
PVAI_VOICE_RECORD_SECONDS=5

# RMS energy threshold for live endpointing (headphones required)
PVAI_VOICE_VAD_THRESHOLD=0.015
# Rolling ASR scheduling interval; actual latency depends on CPU/model speed
PVAI_VOICE_ASR_INTERVAL=0.8

# Native SpeexDSP AEC for live PC mode. Missing library fails explicitly.
PVAI_AEC_ENABLED=true
# Windows: absolute path to a trusted 64-bit libspeexdsp.dll
# Linux: leave empty to discover the system libspeexdsp
PVAI_AEC_LIBRARY=
PVAI_AEC_FILTER_MS=250
# Delay rounded down to 20ms blocks; calibrate on the real audio device
PVAI_AEC_DELAY_MS=40
