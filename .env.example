# قالب تنظیمات محلی PersianVoiceAI — همهٔ متغیرها در docs/CONFIGURATION.md توضیح داده شده‌اند.
# این فایل را به .env کپی کنید. هیچ مقدار خصوصی/رمز را commit نکنید.

# --- مدل متنی و llama-server (محلی) ---
PVAI_MODEL_PATH=models/Qwen3-4B-Q4_K_M.gguf
PVAI_LLAMA_SERVER_URL=http://127.0.0.1:8080
PVAI_N_CTX=4096
PVAI_N_THREADS=2          # 0 = auto؛ روی ۲ هستهٔ فیزیکی ۲ منطقی است
PVAI_N_GPU_LAYERS=0       # 940MX 2GB: پیش‌فرض CPU؛ تغییر فقط با اندازه‌گیری
PVAI_TEMPERATURE=0.7
PVAI_MAX_TOKENS=512
PVAI_TIMEOUT=180
PVAI_LLM_ENABLE_THINKING=false
# PVAI_SYSTEM_PROMPT=تو یک دستیار فارسی‌زبان هستی.

# --- API محلی (بدون احراز هویت؛ عمومی نکنید) ---
PVAI_HOST=127.0.0.1
PVAI_PORT=8000
PVAI_LOG_LEVEL=INFO

# --- ASR: faster-whisper محلی، بدون دانلود ---
PVAI_ASR_MODEL_PATH=models/whisper-small
PVAI_ASR_DEVICE=cpu
PVAI_ASR_COMPUTE_TYPE=int8
PVAI_ASR_THREADS=2
PVAI_ASR_BEAM_SIZE=1
PVAI_ASR_VAD_FILTER=false
PVAI_ASR_PARTIAL_WINDOW_S=6
PVAI_ASR_MAX_FINAL_JOBS=16
PVAI_ASR_WARMUP=true

# --- TTS: Piper محلی، انتخاب صدای زن/مرد ---
PVAI_TTS_VOICE=female
PVAI_TTS_MODEL_PATH=models/piper/fa_IR.onnx
# PVAI_TTS_MODEL_FEMALE=models/piper/fa_IR_female.onnx
# PVAI_TTS_MODEL_MALE=models/piper/fa_IR_male.onnx

# --- VAD / پایان‌گفتار (کالیبراسیون روی دستگاه واقعی لازم است) ---
PVAI_VOICE_VAD_THRESHOLD=0.015
PVAI_VOICE_VAD_OFFSET_RATIO=0.6
PVAI_VOICE_VAD_ONSET_MS=60
PVAI_VOICE_SILENCE_MS=600
PVAI_VOICE_VAD_PRE_ROLL_MS=200
PVAI_VOICE_VAD_MIN_SPEECH_MS=160
PVAI_VOICE_VAD_MAX_SEGMENT_S=15
PVAI_VOICE_VAD_NOISE_ADAPT=true
PVAI_VOICE_VAD_NOISE_MULTIPLIER=2.5
PVAI_VOICE_BARGE_IN_MS=200
PVAI_VOICE_BARGE_IN_MARGIN=1.5

# --- زمان‌بندی خط لوله ---
PVAI_VOICE_ASR_INTERVAL=0.8
PVAI_VOICE_SPEECH_QUEUE=8
PVAI_VOICE_RECORD_SECONDS=5   # فقط حالت عیب‌یابی --turn-based

# --- دستگاه و انتقال صدا (16kHz اجباری است) ---
# نام (زیررشته) یا index؛ مثال: Microphone یا 1
PVAI_AUDIO_INPUT_DEVICE=
PVAI_AUDIO_OUTPUT_DEVICE=
PVAI_AUDIO_SAMPLE_RATE=16000
PVAI_AUDIO_BLOCK_MS=20
PVAI_AUDIO_STALL_S=2.0
PVAI_AUDIO_REOPEN_ATTEMPTS=3
# Frames a reopened stream must deliver before it counts as healthy (default 50 = 1s).
PVAI_AUDIO_REOPEN_STABLE_FRAMES=50

# --- AEC: SpeexDSP native (pip آن را نصب نمی‌کند) ---
PVAI_AEC_ENABLED=true
# Windows: مسیر مطلق DLL ۶۴بیتی؛ Linux: خالی برای جست‌وجوی سیستمی
PVAI_AEC_LIBRARY=
PVAI_AEC_FILTER_MS=250
PVAI_AEC_DELAY_MS=40          # روی دستگاه واقعی کالیبره کنید

# --- حافظهٔ مکالمه (فقط محلی) ---
PVAI_HISTORY_PERSIST=true
PVAI_DATA_DIR=data
PVAI_HISTORY_MAX_MESSAGES=24
PVAI_HISTORY_TOKEN_BUDGET=1536
PVAI_HISTORY_MAX_STORED=500
PVAI_HISTORY_INCLUDE_INTERRUPTED=false
# on: ادامهٔ خودکار آخرین نشست در مسیر زندهٔ محلی (off: هر اجرا نشست تازه)
PVAI_HISTORY_RESUME=on
# نشست ثابت مسیر زندهٔ محلی؛ خالی = آخرین نشست. فقط [A-Za-z0-9_-]
PVAI_VOICE_SESSION_ID=
# 0 = نگه‌داشتن همه؛ >0 = حذف نشست‌های قدیمی‌تر از این تعداد روز
PVAI_HISTORY_RETENTION_DAYS=0

# --- انتقال صوتی WebSocket روی LAN (ESP32-S3؛ پیش‌فرض خاموش) ---
# بدون توکن، هر اتصال عمداً رد می‌شود؛ API صوتی بی‌احراز هویت باز نمی‌شود.
PVAI_WS_ENABLED=false
PVAI_WS_TOKEN=

# --- مشاهده‌پذیری ---
PVAI_METRICS_ENABLED=true
