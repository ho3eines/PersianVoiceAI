# --- Local model runtime (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
PVAI_MODEL=qwen3:4b

# --- Generation defaults ---
PVAI_TEMPERATURE=0.7
PVAI_MAX_TOKENS=512
PVAI_NUM_CTX=4096
# false = thinking disabled (faster on CPU). Use "none" for non-thinking models.
PVAI_THINK=false
PVAI_TIMEOUT=180

# --- Local API ---
PVAI_HOST=127.0.0.1
PVAI_PORT=8000
PVAI_LOG_LEVEL=INFO

# Optional: override the Persian system prompt
# PVAI_SYSTEM_PROMPT=تو یک دستیار فارسی‌زبان هستی.
